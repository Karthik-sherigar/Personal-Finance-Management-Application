                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    console.log(\"\u2705 User registered successfully!\");",
                  "    console.log(\"User ID:\", jsonData.userId);",
                  "    console.log(\"Email:\", pm.request.body.raw ? JSON.parse(pm.request.body.raw).email : \"N/A\");",
                  "} else {",
                  "    console.log(\"\u274c Registration failed\");",
                  "    console.log(\"Status:\", pm.response.code);",
                  "    console.log(\"Message:\", pm.response.json().message);",
                  "}"
